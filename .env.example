# Copy this file to .env and fill in your own values. Never commit .env.

# Simli (avatar video): https://www.simli.com -> API key, and a face you create from your own photo
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Anthropic (the worker's brain): https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional
# PROJECT_DIR=/path/to/the/project/opened/by/default   (defaults to this folder)
# AI_PROJECTS_DIR=~/AI Projects                        (where new projects are created)
# ACCESS_TOKEN=any-long-random-string                  (keeps the call link stable between restarts)
